# ── Pen Playground environment ─────────────────────────────────────────────────
# Copy to .env. Never commit .env.

# Server
PEN_PORT=4000
PEN_PUBLIC_URL=http://localhost:5173
PEN_API_URL=http://localhost:4000
PEN_JWT_SECRET=change-me-32-bytes-minimum-please-really
DATABASE_URL=pglite://.pen-data/db                # pglite://<dir> | pglite://memory | postgres://…

# Language model (OpenAI Responses API). Per-plan keys, no fallback between them.
OPENAI_API_KEY_FREE=
OPENAI_API_KEY_STANDARD=
OPENAI_API_KEY_PROFESSIONAL=
PEN_LLM_MODEL=gpt-5.6-luna
PEN_LLM_OUTLINE_MODEL=gpt-5.6-luna
PEN_LLM_PROVIDER=openai                      # openai | openai-compatible | gemini
PEN_LLM_BASE_URL=                             # for openai-compatible endpoints

# Voice
PEN_TTS_PROVIDER=fish-cloud                  # fish-cloud | fish-bridge | browser (dev only)
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
PEN_TTS_BRIDGE_URL=http://127.0.0.1:8310     # Simurgh tts-bridge when PEN_TTS_PROVIDER=fish-bridge
PEN_STT_PROVIDER=browser                     # browser | ws-relay | deepgram | assemblyai
PEN_STT_RELAY_URL=ws://127.0.0.1:8320        # Simurgh STT host when PEN_STT_PROVIDER=ws-relay
DEEPGRAM_API_KEY=                            # Deepgram nova-3 live streaming when PEN_STT_PROVIDER=deepgram
ASSEMBLYAI_API_KEY=                          # AssemblyAI Universal-Streaming v3 when PEN_STT_PROVIDER=assemblyai
# Knowledge discovery (optional; without any of these the builder uses curated seeds + model-suggested URLs)
SEARXNG_URL=                                 # self-hosted SearXNG, free, wins over Tavily/Exa (deploy/searxng; e.g. http://127.0.0.1:8080)
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# MP4 export (paid plans): ffmpeg + Playwright Chromium on the API host (`pnpm exec playwright install chromium`)
PEN_FFMPEG_PATH=ffmpeg                       # /opt/homebrew/bin/ffmpeg on macOS if not on PATH
PEN_CHROMIUM_PATH=                           # system Chromium instead of Playwright's download (Docker)
PEN_CHROMIUM_ARGS=                           # extra flags, e.g. --disable-dev-shm-usage
PEN_RENDER_BASE_URL=                         # where the renderer opens /replay/:id; defaults to PEN_PUBLIC_URL

# Sign-in (Google Identity Services web client id; one value, two consumers). Empty = off.
GOOGLE_CLIENT_ID=                            # API: verifies the ID token's audience
VITE_GOOGLE_CLIENT_ID=                       # web: shows "Continue with Google"

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                       # `pnpm --filter @pen/api stripe:webhook` writes it
STRIPE_PORTAL_CONFIGURATION_ID=

# Observability
SENTRY_DSN=                                  # Sentry project pen-academy-api (org pen-playground)
SENTRY_CRON_MONITOR_SLUG=                    # production: pen-api-heartbeat (docs/RUNBOOK.md → Alerting)
SENTRY_CRON_INTERVAL_MINUTES=5
SENTRY_AUTH_TOKEN=                           # workstation only: source maps + `pnpm --filter @pen/api sentry:alerts`
SENTRY_ORG=pen-playground
POSTHOG_PERSONAL_API_KEY=                    # workstation only: telemetry:pull, posthog:dashboard
POSTHOG_PROJECT_ID=
VITE_SENTRY_DSN=                             # pen-academy-web
VITE_SENTRY_DSN_DESKTOP=                     # pen-academy-desktop
POSTHOG_PROJECT_TOKEN=                       # PostHog project token (server + web analytics)
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_ENVIRONMENT=development

# Board
VITE_TLDRAW_LICENSE_KEY=

# Stripe price ids (create products in the Stripe dashboard; billing stays disabled until all four exist)
STRIPE_PRICE_STANDARD_MONTH=
STRIPE_PRICE_STANDARD_YEAR=
STRIPE_PRICE_PROFESSIONAL_MONTH=
STRIPE_PRICE_PROFESSIONAL_YEAR=
