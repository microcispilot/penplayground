# ── Pen Playground environment ─────────────────────────────────────────────────
# Copy to .env. Never commit .env.

# Server
PEN_PORT=4000
# Both may carry a path when the app is served under a prefix rather than at the root of its
# host (docs/DEPLOY.md -> "Serving the app under a path prefix"), e.g.
#   PEN_PUBLIC_URL=https://sdjust.penplayground.com/testingxyzbdc
# Every public URL the API builds -- share pages, og:image, the sitemap, MP4 download links,
# Stripe's return URLs -- is derived from them.
PEN_PUBLIC_URL=http://localhost:5173
PEN_API_URL=http://localhost:4000
# Where the WEB APP is mounted on its origin. Build-time only (Vite `base`): it decides the asset,
# lazy-chunk and preload URLs in the bundle, and the app reads it back as import.meta.env.BASE_URL
# for the router's basename and the API origin. "/" is the ordinary deployment.
PEN_BASE_PATH=/
PEN_JWT_SECRET=change-me-32-bytes-minimum-please-really
DATABASE_URL=pglite://.pen-data/db                # pglite://<dir> | pglite://memory | postgres://…

# ── Language model (OpenAI Responses API) ─────────────────────────────────────
# Four keys, one OpenAI project, and NO fallback between them: a missing key is
# an error, never a quiet downgrade to another learner's budget.
#
# WHICH KEY RUNS A CALL is decided by the HOST'S PLAN, once, when the room builds
# its model (services/api/src/services.ts -> modelFor). Every model call in that
# session — the outline, each segment, the answer to a question, the recap —
# bills to that one key. So the three plan keys are how spend is attributed and
# how a rate limit is contained: a rush of free sessions can exhaust the free
# key's limit without touching the budget paying learners depend on. That is the
# whole reason they are separate, and why they must never fall back to each
# other. `checkProviders` refuses to start without all three.
#
#   OPENAI_API_KEY_FREE           hosts on the free plan (the default, and most traffic)
#   OPENAI_API_KEY_STANDARD       hosts on Standard
#   OPENAI_API_KEY_PROFESSIONAL   hosts on Professional
#
# PLATFORM is the odd one out: it belongs to no learner. It is for work the
# platform does for itself, where charging a learner's plan would be wrong —
# session thumbnails, backfills, probes and anything else a background job runs.
# Optional: leave it empty and that work has no key.
#
#   OPENAI_API_KEY_PLATFORM       the platform's own work, attributable to no plan
#
# OPENAI_PROJECT_ID is written down for humans — which OpenAI project the four
# keys belong to, so a bill can be traced. Nothing in the code reads it.
OPENAI_API_KEY_FREE=
OPENAI_API_KEY_STANDARD=
OPENAI_API_KEY_PROFESSIONAL=
OPENAI_API_KEY_PLATFORM=
PEN_LLM_MODEL=gpt-5.6-luna
PEN_LLM_OUTLINE_MODEL=gpt-5.6-luna
PEN_LLM_PROVIDER=openai                      # openai | openai-compatible | gemini
PEN_LLM_BASE_URL=                             # for openai-compatible endpoints

# Voice
PEN_TTS_PROVIDER=fish-cloud                  # fish-cloud | fish-bridge | browser (dev only)
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
PEN_TTS_BRIDGE_URL=http://127.0.0.1:8310     # Simurgh tts-bridge when PEN_TTS_PROVIDER=fish-bridge
PEN_STT_PROVIDER=browser                     # browser | ws-relay | deepgram | assemblyai
PEN_STT_RELAY_URL=ws://127.0.0.1:8320        # Simurgh STT host when PEN_STT_PROVIDER=ws-relay
DEEPGRAM_API_KEY=                            # Deepgram nova-3 live streaming when PEN_STT_PROVIDER=deepgram
ASSEMBLYAI_API_KEY=                          # AssemblyAI Universal-Streaming v3 when PEN_STT_PROVIDER=assemblyai
# Knowledge discovery (optional; without any of these the builder uses curated seeds + model-suggested URLs)
SEARXNG_URL=                                 # self-hosted SearXNG, free, wins over Tavily/Exa (deploy/searxng; e.g. http://127.0.0.1:8080)
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=

# MP4 export (paid plans): ffmpeg + Playwright Chromium on the API host (`pnpm exec playwright install chromium`)
PEN_FFMPEG_PATH=ffmpeg                       # /opt/homebrew/bin/ffmpeg on macOS if not on PATH
PEN_CHROMIUM_PATH=                           # system Chromium instead of Playwright's download (Docker)
PEN_CHROMIUM_ARGS=                           # extra flags, e.g. --disable-dev-shm-usage
PEN_RENDER_BASE_URL=                         # where the renderer opens /replay/:id; defaults to PEN_PUBLIC_URL

# Sign-in (Google Identity Services web client id; one value, two consumers). Empty = off.
GOOGLE_CLIENT_ID=                            # API: verifies the ID token's audience
VITE_GOOGLE_CLIENT_ID=                       # web: shows "Continue with Google"

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                       # `pnpm --filter @pen/api stripe:webhook` writes it
STRIPE_PORTAL_CONFIGURATION_ID=

# Observability
SENTRY_DSN=                                  # Sentry project pen-academy-api (org pen-playground)
# Leave EMPTY here. The heartbeat belongs to the deployed API only (it is set in
# /srv/pen-playground/api.env, see deploy/api.env.example): a laptop that checks in
# to the production monitor and then sleeps raises a missed-check-in issue and
# emails the owner about nothing. docs/RUNBOOK.md → Alerting.
SENTRY_CRON_MONITOR_SLUG=
SENTRY_CRON_INTERVAL_MINUTES=5
SENTRY_AUTH_TOKEN=                           # workstation only: source maps + `pnpm --filter @pen/api sentry:alerts`
SENTRY_ORG=pen-playground
POSTHOG_PERSONAL_API_KEY=                    # workstation only: telemetry:pull, posthog:dashboard
POSTHOG_PROJECT_ID=
VITE_SENTRY_DSN=                             # pen-academy-web
VITE_SENTRY_DSN_DESKTOP=                     # pen-academy-desktop
POSTHOG_PROJECT_TOKEN=                       # PostHog project token (server + web analytics)
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_ENVIRONMENT=development

# Board
VITE_TLDRAW_LICENSE_KEY=

# Stripe price ids (create products in the Stripe dashboard; billing stays disabled until all four exist)
STRIPE_PRICE_STANDARD_MONTH=
STRIPE_PRICE_STANDARD_YEAR=
STRIPE_PRICE_PROFESSIONAL_MONTH=
STRIPE_PRICE_PROFESSIONAL_YEAR=

# ── Off-host backups (Hetzner Storage Box) ────────────────────────────────────
# The nightly backup sidecar copies each night to $PEN_BACKUP_RCLONE_REMOTE.
# The key pair lives here so a rebuilt host never needs a new one: deploy.sh
# installs the private key at /root/.ssh/pen-backup (mode 600) and writes
# backup/rclone/rclone.conf when the host has none. The public half is already
# authorised on the Storage Box — losing it means adding a new key by hand in
# the Hetzner Console, which is exactly what these variables prevent.
# Base64 so the PEM survives as a single line: base64 -w0 /root/.ssh/pen-backup
PEN_BACKUP_SSH_KEY_B64=
PEN_BACKUP_SSH_PUBLIC_KEY=
# The Storage Box's own host key, so the nightly copy is pinned rather than
# trusted on sight — the stream is the database leaving the machine. Get it with
#   ssh-keyscan -p 23 -t ssh-ed25519 <PEN_BACKUP_REMOTE_HOST>
# and paste the one line that does not start with '#'.
PEN_BACKUP_KNOWN_HOSTS=
PEN_BACKUP_REMOTE_USER=
PEN_BACKUP_REMOTE_HOST=
PEN_BACKUP_REMOTE_PORT=23
# Empty = backups stay on the host's own disk, which is not a backup.
PEN_BACKUP_RCLONE_REMOTE=
