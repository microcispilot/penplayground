{
  "name": "@pen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --watch --import tsx src/main.ts",
    "start": "node --env-file=../../.env --import tsx src/main.ts",
    "build": "node --import tsx scripts/build.ts",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "voices:assign": "node --import tsx scripts/assign-voices.ts",
    "telemetry:pull": "node --env-file=../../.env --import tsx scripts/pull-telemetry.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.1",
    "@hono/node-ws": "1.3.1",
    "@pen/conductor": "workspace:*",
    "@pen/contracts": "workspace:*",
    "@pen/db": "workspace:*",
    "@pen/knowledge": "workspace:*",
    "@pen/llm": "workspace:*",
    "@pen/onten": "workspace:*",
    "@pen/session-engine": "workspace:*",
    "@pen/voice": "workspace:*",
    "@sentry/node": "10.75.0",
    "fasttext.wasm.js": "1.0.0",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "nanoid": "6.0.1",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "postgres": "3.4.9",
    "posthog-node": "5.52.4",
    "stripe": "22.6.2",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
