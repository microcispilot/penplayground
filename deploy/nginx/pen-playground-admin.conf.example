# Pen Playground operations console edge vhost for prod-app-01 (ADR-0026) — copy to
# /etc/nginx/sites-available/pen-playground-admin.conf, replace ADMIN_DOMAIN (all occurrences),
# symlink into sites-enabled, `nginx -t && systemctl reload nginx`.
#
# First pass (before the certificate exists): keep ONLY the port-80 server block enabled, run
#   certbot certonly --webroot -w /var/www/letsencrypt -d ADMIN_DOMAIN
# then enable the TLS block.
#
# A hostname of its own — `admin.penplayground.com`, say — and never a path on the public
# domain. Three reasons, in order of how much they matter:
#
#   1. The console's stored bearer lives in that origin's localStorage. On the public domain it
#      would share storage with the learner app, and an XSS anywhere in the product would reach
#      an operator's token.
#   2. The console's Content-Security-Policy admits this origin, Google sign-in and Sentry's
#      ingest, and nothing else. The public site's has to admit an ad network and a whiteboard
#      library, and the two cannot be one policy without the strict one becoming the loose one.
#   3. Anything reached by hostname can be taken away by hostname: dropping this file offline is
#      one `rm` and a reload, with nothing else to reason about.
#
# The console is still inert without `PEN_ADMIN_EMAILS` in api.env: every admin route answers
# 403 to everyone. That is the authorisation; this file is only the door.
#
# Optional and recommended: if the operators work from known addresses, uncomment the allow/deny
# block. Everything behind it is already authenticated, so this is a second lock, not the lock.

server {
    listen 80;
    listen [::]:80;
    server_name ADMIN_DOMAIN;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://ADMIN_DOMAIN$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ADMIN_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/ADMIN_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ADMIN_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    server_tokens off;
    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Second lock, if the operators work from known addresses.
    # allow 203.0.113.4;
    # deny all;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    # Everything goes to the console container, which serves the bundle and
    # proxies /api to the API container itself. The console's own security
    # headers come from there (deploy/admin/nginx.conf).
    location / {
        proxy_pass http://127.0.0.1:4202;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
