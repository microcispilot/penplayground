# Pen Playground edge vhost — one template for every environment (ADR-0059). deploy/deploy.sh
# renders it with the environment's values and installs it as
# /etc/nginx/sites-available/STACK.conf (+ the sites-enabled link), then `nginx -t` and reload.
#
# Placeholders: DOMAIN, STACK (pen-staging / pen-production), STACK_ID (the same with
# underscores, for nginx variable names), ENVIRONMENT, API_PORT, WEB_PORT, LIVEKIT_UPSTREAM,
# ENV_ROOT (the stack's directory on the host, where the includes below are rendered by
# deploy/nginx/render.sh).
#
# Everything is forwarded to the environment's web container, which serves the SPA and proxies
# /api, /experts/portraits, /s and the /ws WebSocket to its own API container. /livekit/ goes
# straight to the media server's signalling port; media itself flows over 7881/tcp + 7882/udp.
#
# WebSocket upgrade map, named per stack so both environments' vhosts load side by side
# (prod-app-01 also defines a global `$connection_upgrade` in /etc/nginx/conf.d/ws_upgrade.conf).
map $http_upgrade $STACK_ID_connection_upgrade {
    default upgrade;
    ""      close;
}

# What the environment adds at http level (staging: the gate's cookie maps). Empty for production.
include ENV_ROOT/nginx/http.inc;

# Per-environment server blocks (production: www → apex). Empty for staging.
include ENV_ROOT/nginx/servers.inc;

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN SERVER_NAMES_EXTRA;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://DOMAIN$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name DOMAIN;

    ssl_certificate /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    # HSTS: a year, subdomains included. Add `preload` only once you are sure
    # every subdomain will stay on TLS for good.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # The Content-Security-Policy is served by the web container itself
    # (deploy/web/nginx.conf, generated from apps/web/csp.ts). It is deliberately
    # NOT repeated here: two copies would drift, and nginx sends both, so a
    # browser would enforce the intersection and silently break whichever tier
    # was older. To see what the container serves:
    #   pnpm --filter @pen/web csp:print

    client_max_body_size 10m;

    # What differs by environment inside this server: for staging, the crawler shutters
    # (X-Robots-Tag, robots.txt, no sitemap) and the redirect from the old path prefix;
    # for production, nothing.
    include ENV_ROOT/nginx/server.inc;

    # LiveKit signalling (wss://DOMAIN/livekit → ws://LIVEKIT_UPSTREAM/rtc) and its HTTP API. The
    # trailing slashes strip the /livekit prefix; a room lives for up to three hours.
    location /livekit/ {
        proxy_pass http://LIVEKIT_UPSTREAM/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $STACK_ID_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The web location: open (production) or gated behind one shared password (staging,
    # ADR-0061), as the environment's PEN_EDGE_GATE says. Both forms forward through
    # proxy-web.inc, so they differ only in who gets in.
    include ENV_ROOT/nginx/web.inc;
}
