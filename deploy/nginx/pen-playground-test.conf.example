# Pen Playground TEST vhost for prod-app-01 — the product served under an unguessable path on its
# own hostname, while the public site shows something else. Copy to
# /etc/nginx/sites-available/pen-playground-test.conf, replace TEST_DOMAIN and BASE_PATH (all
# occurrences), symlink into sites-enabled, `nginx -t && systemctl reload nginx`.
#
#   TEST_DOMAIN   sdjust.penplayground.com
#   BASE_PATH     testingxyzbdc      (no slashes — they are written out below)
#
# deploy/deploy.sh fills both in for you when it syncs the stack:
#   PEN_VHOST=test PEN_DOMAIN=sdjust.penplayground.com PEN_BASE_PATH=/testingxyzbdc deploy/deploy.sh
# and the web image must have been built with the SAME prefix baked in
# (`--build-arg PEN_BASE_PATH=/testingxyzbdc`), because Vite's `base` decides the asset,
# lazy-chunk and preload URLs at build time. A mismatch is a blank page with 404s in the console.
#
# First pass (before the certificate exists): keep ONLY the port-80 server block enabled, run
#   certbot certonly --webroot -w /var/www/letsencrypt -d TEST_DOMAIN
# then enable the TLS block. Style follows deploy/nginx/pen-playground.conf.example.
#
# What is different from the production vhost, and why:
#   - everything lives under /BASE_PATH/; the prefix is STRIPPED before it is proxied, so the
#     containers behind this are byte-identical to the production ones and know nothing about it;
#   - /BASE_PATH/api/ and /BASE_PATH/ws/ go straight to the API container (127.0.0.1:4200) rather
#     than through the web container — one hop fewer for the lesson socket, same headers and
#     timeouts as production;
#   - every response carries `X-Robots-Tag: noindex, nofollow` and the host serves a robots.txt
#     that disallows everything, so a test deployment can never turn up in a search index.
#
# WebSocket upgrade map. prod-app-01 defines `$connection_upgrade` globally in
# /etc/nginx/conf.d/ws_upgrade.conf and pen-playground.conf.example defines
# `$pen_connection_upgrade`; this file uses its own name so all three can be enabled at once.
map $http_upgrade $pen_test_connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name TEST_DOMAIN;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://TEST_DOMAIN$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name TEST_DOMAIN;

    ssl_certificate /etc/letsencrypt/live/TEST_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/TEST_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    # HSTS: the apex vhost already sends `includeSubDomains`, so this host is committed to TLS
    # either way. Sending it here too keeps the two consistent.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # Nothing on this host is for an index. `X-Robots-Tag` is the half that works on assets and
    # on API responses, where a <meta> tag cannot reach; robots.txt below is the half a crawler
    # reads before it asks for anything at all.
    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
    # The Content-Security-Policy is served by the web container itself (deploy/web/nginx.conf,
    # generated from apps/web/csp.ts) and deliberately NOT repeated here — see the note in
    # pen-playground.conf.example: two copies drift, and the browser enforces the intersection.

    client_max_body_size 10m;

    # ── crawlers ───────────────────────────────────────────────────────────
    # A crawler reads /robots.txt at the root of the host and nowhere else, so this one line is
    # what keeps the whole test deployment — prefix included — out of every index. It is served
    # here rather than proxied so it answers even when the stack is down.
    location = /robots.txt {
        default_type text/plain;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        add_header Cache-Control "no-store" always;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    # The app's own sitemap would advertise the prefixed URLs; on a test host there is nothing
    # to advertise. Answering 404 here also keeps the production sitemap the only real one.
    location = /sitemap.xml {
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        return 404;
    }

    # ── the app ────────────────────────────────────────────────────────────
    # Everything that is not the app is sent to it. This is what the brief asks for and it is
    # the friendly behaviour for the handful of people who have the link; it does mean anyone
    # who finds the HOSTNAME is told the path. To make the host silent instead, replace the
    # body of this block with `return 404;` — nothing else in this file depends on it.
    location = / {
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        return 308 https://TEST_DOMAIN/BASE_PATH/;
    }

    # react-router renders the home link as the bare prefix (`to="/"` under a basename), so a
    # reload there must land on the app rather than on the catch-all below.
    location = /BASE_PATH {
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        return 308 https://TEST_DOMAIN/BASE_PATH/;
    }

    # API. Straight to the API container, prefix stripped by the trailing slash on proxy_pass:
    # /BASE_PATH/api/sessions → /api/sessions. Same headers and timeouts as the production edge.
    location ^~ /BASE_PATH/api/ {
        proxy_pass http://127.0.0.1:4200/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        # A lesson streams; nothing here may be held back in a buffer.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The lesson socket: one WebSocket for the life of a session, up to an hour.
    location ^~ /BASE_PATH/ws/ {
        proxy_pass http://127.0.0.1:4200/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pen_test_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Everything else under the prefix is the web container: the SPA and its assets, the share
    # pages (/s/:id), the expert portraits and the app's own robots.txt. The trailing slash on
    # proxy_pass strips /BASE_PATH, so the container serves exactly what it serves in production.
    location ^~ /BASE_PATH/ {
        proxy_pass http://127.0.0.1:4201/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pen_test_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Request-ID $request_id;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Human-to-human audio (rooms). Not under the prefix: the browser is told this URL by the
    # API (LIVEKIT_URL=wss://TEST_DOMAIN/livekit), not by the bundle, so it is a host path like
    # it is in production. Media itself flows over 7881/tcp + 7882/udp, not through nginx.
    location /livekit/ {
        proxy_pass http://LIVEKIT_UPSTREAM/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pen_test_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Anything else on this host: not found, and not indexed.
    location / {
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet" always;
        return 404;
    }
}
