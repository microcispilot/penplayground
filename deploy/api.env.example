# ── Pen Playground API — production environment (copy to /srv/pen-playground/api.env, chmod 600) ────
# Every variable the API reads (services/api/src/config.ts). An empty value means "unset".
# Comments only on their own lines: Compose's env_file keeps `# …` after a value as part of it.
# NODE_ENV=production, PEN_PORT=4000 and PEN_DATA_DIR=/data are fixed by docker-compose.yml.
# In production the API refuses PEN_LLM_PROVIDER=fake, PEN_TTS_PROVIDER=silent and PEN_DEV_PLAN.

# ── Server ────────────────────────────────────────────────────────────────────
# Public origin of the app (share links, CORS allowlist) and of the API (same origin behind nginx).
PEN_PUBLIC_URL=https://DOMAIN
PEN_API_URL=https://DOMAIN
# At least 32 characters: openssl rand -base64 48
PEN_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random
# Postgres inside the stack; user, password and database must match postgres.env.
DATABASE_URL=postgres://pen:CHANGE_ME_openssl_rand_hex_24@postgres:5432/pen
# pino level: trace | debug | info | warn | error
PEN_LOG_LEVEL=info

# ── Language model (OpenAI Responses API). Per-plan keys, no fallback between them. ───────────
# openai | openai-compatible
PEN_LLM_PROVIDER=openai
PEN_LLM_MODEL=gpt-5.6-luna
PEN_LLM_OUTLINE_MODEL=gpt-5.6-luna
# Only for openai-compatible endpoints.
PEN_LLM_BASE_URL=
# auto | default | flex | priority (optional)
PEN_LLM_SERVICE_TIER=
OPENAI_API_KEY_FREE=
OPENAI_API_KEY_STANDARD=
OPENAI_API_KEY_PROFESSIONAL=

# ── Voice ──────────────────────────────────────────────────────────────────────
# fish-cloud | fish-bridge
PEN_TTS_PROVIDER=fish-cloud
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
# Only when PEN_TTS_PROVIDER=fish-bridge (a Simurgh tts-bridge reachable from the container).
PEN_TTS_BRIDGE_URL=http://127.0.0.1:8310
# browser | ws-relay | deepgram | assemblyai
PEN_STT_PROVIDER=browser
# ws://… when PEN_STT_PROVIDER=ws-relay
PEN_STT_RELAY_URL=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# ── Knowledge discovery for topic misses. SearXNG is free and wins when set; then Tavily, then Exa. ──
SEARXNG_URL=http://searxng:8080
TAVILY_API_KEY=
EXA_API_KEY=

# ── Sign-in. Google Identity Services web client id (same value as the web build's
# VITE_GOOGLE_CLIENT_ID). Empty = sign-in off; /api/health reports google:false. ───────────────
GOOGLE_CLIENT_ID=

# ── Billing (Stripe). Disabled until the secret key and all four price ids exist. ─────────────
STRIPE_SECRET_KEY=
# Signing secret of the endpoint https://<DOMAIN>/api/billing/webhook; register it with
# `pnpm --filter @pen/api stripe:webhook` (writes the secret into the repo .env; copy it here).
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_STANDARD_MONTH=
STRIPE_PRICE_STANDARD_YEAR=
STRIPE_PRICE_PROFESSIONAL_MONTH=
STRIPE_PRICE_PROFESSIONAL_YEAR=

# ── Rooms audio (self-hosted LiveKit; Professional hosts, up to 12 participants) ─────────────
# Inside the stack docker-compose.yml sets all four from /srv/pen-playground/.env (deploy.sh writes
# LIVEKIT_URL=wss://DOMAIN/livekit and generates the key pair once), and compose `environment`
# wins over this file. Set them here only when the API runs outside the stack. Any of the three
# missing → the feature is off: /api/health reports rooms:false and the token route answers 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# HTTP API of the server as seen from the API process; derived from LIVEKIT_URL when empty.
LIVEKIT_API_URL=

# ── Observability ──────────────────────────────────────────────────────────────
# Sentry project pen-academy-api (Sentry project slugs keep the original name)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Dead-man's switch (docs/RUNBOOK.md → "Alerting"): with a DSN set, the API runs its
# readiness probe every SENTRY_CRON_INTERVAL_MINUTES and checks in to this Sentry Cron
# monitor. Silence for one interval + margin opens an issue, so a dead API is visible
# within ~10 minutes with no traffic at all. Create the monitor with
# `pnpm --filter @pen/api sentry:alerts`. Empty = no heartbeat.
SENTRY_CRON_MONITOR_SLUG=pen-api-heartbeat
SENTRY_CRON_INTERVAL_MINUTES=5
# Server-side analytics; disabled when empty.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# ── Product knobs ──────────────────────────────────────────────────────────────
# Free plan: a video ad every N segments (a topic-miss preparation ad consumes the first slot).
PEN_ADS_EVERY_SEGMENTS=3
# Video ad demand (docs/ADS.md): the Google Ad Manager VAST tag for the free plan's in-stream ads.
# Empty → the free plan shows no ads and the API logs why at boot (`ads.off`).
PEN_AD_TAG_URL=
# Estimated net eCPM in USD per 1 000 completed ads; only feeds the per-session revenue estimate.
PEN_AD_ECPM_USD=8
