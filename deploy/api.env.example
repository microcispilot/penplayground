# ── Pen Playground API — production environment (copy to /srv/pen-playground/api.env, chmod 600) ────
# Every variable the API reads (services/api/src/config.ts). An empty value means "unset".
# Comments only on their own lines: Compose's env_file keeps `# …` after a value as part of it.
# NODE_ENV=production, PEN_PORT=4000 and PEN_DATA_DIR=/data are fixed by docker-compose.yml.
# In production the API refuses PEN_LLM_PROVIDER=fake, PEN_TTS_PROVIDER=silent and PEN_DEV_PLAN.

# ── Server ────────────────────────────────────────────────────────────────────
# Public origin of the app (share links, CORS allowlist) and of the API (same origin behind nginx).
# Under a path prefix these carry it too: https://sdjust.penplayground.com/testingxyzbdc
# (deploy.sh writes both when PEN_PUBLIC_URL / PEN_API_URL are set for the deploy).
PEN_PUBLIC_URL=https://DOMAIN
PEN_API_URL=https://DOMAIN
# At least 32 characters: openssl rand -base64 48
PEN_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random
# Postgres inside the stack; user, password and database must match postgres.env.
DATABASE_URL=postgres://pen:CHANGE_ME_openssl_rand_hex_24@postgres:5432/pen
# pino level: trace | debug | info | warn | error
PEN_LOG_LEVEL=info

# ── Language model (OpenAI Responses API). Per-plan keys, no fallback between them. ───────────
# openai | openai-compatible
PEN_LLM_PROVIDER=openai
PEN_LLM_MODEL=gpt-5.6-luna
PEN_LLM_OUTLINE_MODEL=gpt-5.6-luna
# Only for openai-compatible endpoints.
PEN_LLM_BASE_URL=
# Session thumbnails (ADR-0021): one gpt-image-1 generation per session at
# 1536x1024, downscaled to every size we render. Measured 2026-09-18:
# low = 400 image tokens, ~11 s, $0.0163; medium = 1568, ~18 s, $0.063.
# low is indistinguishable at card width, so it is the default.
PEN_IMAGE_MODEL=gpt-image-1
PEN_THUMBNAIL_QUALITY=low
# auto | default | flex | priority (optional)
PEN_LLM_SERVICE_TIER=
# ── Language model (OpenAI Responses API) ─────────────────────────────────────
# Four keys, one OpenAI project, and NO fallback between them: a missing key is
# an error, never a quiet downgrade to another learner's budget.
#
# WHICH KEY RUNS A CALL is decided by the HOST'S PLAN, once, when the room builds
# its model (services/api/src/services.ts -> modelFor). Every model call in that
# session — the outline, each segment, the answer to a question, the recap —
# bills to that one key. So the three plan keys are how spend is attributed and
# how a rate limit is contained: a rush of free sessions can exhaust the free
# key's limit without touching the budget paying learners depend on. That is the
# whole reason they are separate, and why they must never fall back to each
# other. `checkProviders` refuses to start without all three.
#
#   OPENAI_API_KEY_FREE           hosts on the free plan (the default, and most traffic)
#   OPENAI_API_KEY_STANDARD       hosts on Standard
#   OPENAI_API_KEY_PROFESSIONAL   hosts on Professional
#
# A session's BACKGROUND work bills to the host's plan key too: the catalogue
# card's copy and its generated thumbnail are that learner's session, so they
# run on the same key the lesson did (services/api/src/rooms.ts -> billTo).
#
# PLATFORM is the odd one out: it belongs to no learner. It is for work the
# platform does for itself, where charging a learner's plan would be wrong —
# the thumbnail backfill, probes, pack prewarming. Optional: leave it empty and
# that work has no key, and the scripts that need it say so and stop.
#
#   OPENAI_API_KEY_PLATFORM       the platform's own work, attributable to no plan
#
# OPENAI_PROJECT_ID is written down for humans — which OpenAI project the four
# keys belong to, so a bill can be traced. Nothing in the code reads it.
OPENAI_API_KEY_FREE=
OPENAI_API_KEY_STANDARD=
OPENAI_API_KEY_PROFESSIONAL=
OPENAI_API_KEY_PLATFORM=

# ── Intent classifier ──────────────────────────────────────────────────────────
# Who reads a learner utterance the local heuristics cannot place.
#   model  the composing model, one structured-output call (what it has always been)
#   jev    TypeSafe's hosted decisions model on OpenRouter, in front of that call:
#          measured p50 168 ms / p95 270 ms against the model's 655 ms first token,
#          $0.0000297 a turn, and it reports a confidence — anything under 0.70,
#          any error and any timeout falls straight back to `model`. Confirm the
#          key with `pnpm --filter @pen/api intent:probe`. This line turns it off.
# `jev` is the default since ADR-0025; without OPENROUTER_API_KEY the room quietly uses
# the session model instead, which is what it did before the hosted classifier existed.
PEN_INTENT_PROVIDER=jev
# Pinned: `typesafe/jev-latest` exists in TypeSafe's console but OpenRouter rejects it.
PEN_INTENT_MODEL=typesafe/jev-1.13
# OpenRouter, NOT OpenAI: a separate gateway and a separate account. The per-plan
# OPENAI_API_KEY_* keys are never reused here. Required when PEN_INTENT_PROVIDER=jev.
OPENROUTER_API_KEY=

# ── Voice ──────────────────────────────────────────────────────────────────────
# fish-cloud | fish-bridge
PEN_TTS_PROVIDER=fish-cloud
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
# Only when PEN_TTS_PROVIDER=fish-bridge (a Simurgh tts-bridge reachable from the container).
PEN_TTS_BRIDGE_URL=http://127.0.0.1:8310
# browser | ws-relay | deepgram | assemblyai
PEN_STT_PROVIDER=browser
# ws://… when PEN_STT_PROVIDER=ws-relay
PEN_STT_RELAY_URL=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# ── Knowledge discovery for topic misses. SearXNG is free and wins when set; then Tavily, then Exa. ──
SEARXNG_URL=http://searxng:8080
TAVILY_API_KEY=
EXA_API_KEY=

# ── Sign-in. Google Identity Services web client id (same value as the web build's
# VITE_GOOGLE_CLIENT_ID). Empty = sign-in off; /api/health reports google:false. ───────────────
GOOGLE_CLIENT_ID=

# ── Operations console (ADR-0025, ADR-0026) ───────────────────────────────────────────────────
# Who may read and change the runtime settings: a comma-separated list of the Google addresses
# allowed into /api/admin/* and the console at apps/admin. EMPTY MEANS NOBODY — every admin route
# answers 403, which is the right default for a deployment that has not thought about it.
# Revoking access is this line plus a restart; it does not wait for a token to expire.
PEN_ADMIN_EMAILS=
# How often each API process re-reads the stored settings. One small indexed read per interval;
# every read in between is an in-memory lookup. 0 reads once at boot and never again.
PEN_RUNTIME_CONFIG_POLL_MS=15000

# ── Billing (Stripe). Disabled until the secret key and all four price ids exist. ─────────────
STRIPE_SECRET_KEY=
# Signing secret of the endpoint https://<DOMAIN>/api/billing/webhook; register it with
# `pnpm --filter @pen/api stripe:webhook` (writes the secret into the repo .env; copy it here).
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_STANDARD_MONTH=
STRIPE_PRICE_STANDARD_YEAR=
STRIPE_PRICE_PROFESSIONAL_MONTH=
STRIPE_PRICE_PROFESSIONAL_YEAR=

# ── Rooms audio (self-hosted LiveKit; Professional hosts, up to 12 participants) ─────────────
# Inside the stack docker-compose.yml sets all four from /srv/pen-playground/.env (deploy.sh writes
# LIVEKIT_URL=wss://DOMAIN/livekit and generates the key pair once), and compose `environment`
# wins over this file. Set them here only when the API runs outside the stack. Any of the three
# missing → the feature is off: /api/health reports rooms:false and the token route answers 503.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# HTTP API of the server as seen from the API process; derived from LIVEKIT_URL when empty.
LIVEKIT_API_URL=

# ── Observability ──────────────────────────────────────────────────────────────
# Sentry project pen-academy-api (Sentry project slugs keep the original name)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Dead-man's switch (docs/RUNBOOK.md → "Alerting"): with a DSN set, the API runs its
# readiness probe every SENTRY_CRON_INTERVAL_MINUTES and checks in to this Sentry Cron
# monitor. Silence for one interval + margin opens an issue, so a dead API is visible
# within ~10 minutes with no traffic at all. Create the monitor with
# `pnpm --filter @pen/api sentry:alerts`. Empty = no heartbeat.
SENTRY_CRON_MONITOR_SLUG=pen-api-heartbeat
SENTRY_CRON_INTERVAL_MINUTES=5
# Server-side analytics; disabled when empty.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# ── Product knobs ──────────────────────────────────────────────────────────────
# Free plan: a video ad every N segments (a topic-miss preparation ad consumes the first slot).
PEN_ADS_EVERY_SEGMENTS=3
# Video ad demand (docs/ADS.md): the Google Ad Manager VAST tag for the free plan's in-stream ads.
# Empty → the free plan shows no ads and the API logs why at boot (`ads.off`).
PEN_AD_TAG_URL=
# Estimated net eCPM in USD per 1 000 completed ads; only feeds the per-session revenue estimate.
PEN_AD_ECPM_USD=8

# ── Off-host backups (Hetzner Storage Box) ────────────────────────────────────
# Read by deploy.sh from the *workstation's* .env, not by the API: they are here
# so the whole backup story is described in one place. deploy.sh installs the
# private key at /root/.ssh/pen-backup (0600) and a copy at
# /srv/pen-playground/backup/rclone/pen-backup for the backup container, and
# writes rclone.conf from the host/user/port below. A host that already has a
# key is left alone. docs/RUNBOOK.md → "Backups" has the recovery story.
PEN_BACKUP_SSH_KEY_B64=
PEN_BACKUP_SSH_PUBLIC_KEY=
# The Storage Box's host keys, so the nightly copy is pinned rather than trusted
# on sight — the stream is the database leaving the machine. ALL of them, not
# one: the box offers rsa, ecdsa and ed25519, rclone may negotiate any, and
# pinning a single line failed in production with "knownhosts: key mismatch".
#   ssh-keyscan -p 23 <PEN_BACKUP_REMOTE_HOST> | grep -v '^#' | base64
PEN_BACKUP_KNOWN_HOSTS_B64=
PEN_BACKUP_REMOTE_USER=
PEN_BACKUP_REMOTE_HOST=
PEN_BACKUP_REMOTE_PORT=23
PEN_BACKUP_RCLONE_REMOTE=
