{
  "name": "pen-academy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @pen/web e2e",
    "test:edge": "deploy/nginx/test.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.10.13",
    "typescript": "5.9.3"
  }
}
